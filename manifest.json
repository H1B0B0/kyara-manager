{
  "manifest_version": 3,
  "name": "Kyara Manager — Pilote Auto, Doublons, Marché & Boosters",
  "short_name": "Kyara Manager",
  "version": "1.2.1",
  "description": "Pilote auto Kyara.games : auto-vente des doublons, recyclage, flip marché et ouverture live des boosters gratuits conseillés.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ouvrir Kyara Manager",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://kyara.games/*",
    "https://*.kyara.games/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kyara.games/*",
        "https://*.kyara.games/*"
      ],
      "js": [
        "lib/analytics.js",
        "lib/i18n.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
