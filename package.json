{
  "name": "kyara-manager",
  "version": "1.5.0",
  "description": "Pilote automatique et tableau de bord analytique pour Kyara.games (Manifest V3) : auto-vente des doublons, auto-recyclage, flip marché et ouverture live de boosters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/H1B0B0/kyara-manager.git"
  },
  "homepage": "https://github.com/H1B0B0/kyara-manager#readme",
  "bugs": {
    "url": "https://github.com/H1B0B0/kyara-manager/issues"
  },
  "keywords": [
    "kyara",
    "kyara-games",
    "chrome-extension",
    "manifest-v3",
    "tcg",
    "automation"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "package:cws": "node scripts/package-cws.mjs",
    "token:cws": "node scripts/get-cws-refresh-token.mjs",
    "release": "npm version patch && git push origin main --tags",
    "release:minor": "npm version minor && git push origin main --tags",
    "promo": "node scripts/generate-promo.mjs",
    "format-screens": "node scripts/format-screenshots.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "version": "node scripts/sync-version.mjs && git add manifest.json"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
